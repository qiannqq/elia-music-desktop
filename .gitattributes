# 统一换行符：源码与文档一律 LF，避免跨平台协作时整文件 diff
* text=auto
*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.cc     text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf

# 二进制文件不做换行处理
*.png    binary
*.jpg    binary
*.ico    binary
*.ttf    binary
*.jar    binary
*.dll    binary
*.exe    binary
