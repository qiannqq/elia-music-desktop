<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 包源配置（构建 Windows 桌面版必需）

  背景：`audioplayers_windows` 插件在 CMake 阶段会执行
      nuget.exe install Microsoft.Windows.ImplementationLibrary ...
  本机用户级 NuGet.Config 不存在（%APPDATA%\NuGet\NuGet.Config），
  导致 nuget 报 "Feeds used:" 为空 → `Argument cannot be null or empty 参数名: primarySources`。

  nuget.exe 会从**当前工作目录向上逐级查找** NuGet.Config，
  构建时的工作目录是 `build/windows/x64`，因此放在项目根即可被自动发现。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
